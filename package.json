    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "check:secrets": "node scripts/check-secrets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:contrast && npm run test && npm run build && npm run check:secrets",
